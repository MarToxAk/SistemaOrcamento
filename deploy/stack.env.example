# Tailscale
TS_AUTHKEY=

# Imagens (obrigatorio se nao trocar o fallback no compose)
BACKEND_IMAGE=ghcr.io/martoxak/orcamento-backend:latest
FRONTEND_IMAGE=ghcr.io/martoxak/orcamento-frontend:latest

# Postgres (servico interno da stack)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_essa_senha
POSTGRES_DB=orcamento

# Backend
NODE_ENV=production
PORT=4000
APP_BASE_URL=https://seu-dominio.com
DATABASE_URL=postgresql://postgres:troque_essa_senha@postgres:5432/orcamento
WAIT_FOR_DB_TIMEOUT_MS=120000
WAIT_FOR_DB_INTERVAL_MS=2000

# Integracoes
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
# Automacao de fechamento de conversa (Chatwoot > Automacao > conversation_resolved)
# Token = trecho final da URL .../api/integrations/chatwoot/automation/webhook/<token>
CHATWOOT_AUTOMATION_WEBHOOK_TOKEN=
# IDs das caixas de entrada monitoradas, separados por virgula (ex: 1,2,3)
CHATWOOT_AUTOMATION_INBOX_IDS=
CHATWOOT_AUTOMATION_STATUS_FECHAMENTO=ENTREGUE,ENVIADO,CANCELADO
# IA opcional da mensagem de fechamento (vazio = frase fixa)
CHATWOOT_AI_URL=
CHATWOOT_AI_TOKEN=
CHATWOOT_AI_MODEL=openclaw/main

ATHOS_PG_HOST=
ATHOS_PG_DB=
ATHOS_PG_USER=
ATHOS_PG_PASS=
ATHOS_PG_PORT=5432

# ID do usuario Athos que representa o Sistema de Orcamento (integer).
# Deve ser um idfuncionariousuario valido da tabela funcionario_usuario no banco Athos.
# Usado como idusuariocadastro e idusuarioalteracao nas operacoes de escrita de produto.
ATHOS_SISTEMA_USUARIO_ID=

# Baixa automatica no Athos (Fase 43). Somente o texto "false" desliga ATHOS_BAIXA_AUTO.
# Primeira subida em producao: deixe ATHOS_BAIXA_AUTO=false ate a verificacao guiada (plano 43-04)
# e o DBA conceder INSERT/UPDATE ao usuario ATHOS_PG_USER nas tabelas da baixa.
ATHOS_BAIXA_AUTO=true
ATHOS_BAIXA_ID_FORMA_PAGAMENTO=10
ATHOS_BAIXA_ID_LIVRO_REGISTRO=2
ATHOS_BAIXA_ID_FUNCIONARIO=1
# Percentual de multa por atraso (0 a 100, padrao 2); coluna real em conf_financeiro desconhecida
ATHOS_BAIXA_MULTA_PERCENTUAL=2

# Orcamento criado pela IA no Athos (Fase 44)
# ATHOS_ORCAMENTO_ESCRITA: somente o texto "true" habilita a gravacao; ausente ou qualquer outro valor responde
# 503 ESCRITA_DESABILITADA. GETs e a simulacao (simular=true) funcionam com a escrita desligada.
# Manter false ate concluir 44-ROTEIRO-VERIFICACAO-MANUAL.md e o DBA conceder os GRANTs: INSERT em orcamento,
# orcamento_item e orcamento_forma_pagamento, DELETE em orcamento_forma_pagamento e USAGE nas quatro sequencias.
ATHOS_ORCAMENTO_ESCRITA=false
# Autor e vendedor do orcamento e terminal: OBRIGATORIOS, inteiros positivos validados contra funcionario_usuario,
# funcionario e terminal. Escolha no Passo 0 do roteiro. Sem elas a API responde CONFIG_INVALIDA.
ATHOS_ORCAMENTO_ID_FUNCIONARIO=
ATHOS_ORCAMENTO_ID_VENDEDOR=
ATHOS_ORCAMENTO_ID_TERMINAL=
# Forma de pagamento PIX desta instalacao: precisa estar ativa e ser tipo 1 ou 4. A IA nao escolhe forma de pagamento.
ATHOS_ORCAMENTO_ID_FORMA_PAGAMENTO=5

# Aviso de boletos a vencer e atrasados (Fase 45)
# O job roda as 08:00 e 14:00 (America/Sao_Paulo) e envia e-mail REAL aos clientes, usando as SMTP_* e SMTP_FROM
# ja configuradas. COBRANCA_AVISO_ATIVO: somente o texto "true" liga (ausente ou qualquer outro valor = desligado).
# Para conferir quem receberia o aviso sem ligar nada: GET /api/cobranca/aviso-vencimento/previa (header
# x-admin-api-key). COBRANCA_AVISO_DRY_RUN=true so registra em log o que seria enviado e so vale com o envio ligado.
# Ordem de ativacao em 45-ROTEIRO-ATIVACAO.md: previa, depois dry-run, depois envio real.
COBRANCA_AVISO_ATIVO=false
COBRANCA_AVISO_DRY_RUN=false

# Chatwoot: etiquetas por fase, cliente frequente e atraso da mensagem de fechamento (Fase 51).
# Os valores abaixo sao os padroes do codigo; so preencha para mudar.
# CHATWOOT_ETIQUETAS_ATIVAS: somente o texto "false" desliga a sincronizacao de etiquetas por status do orcamento
# (fase e cliente-frequente); isso nao desliga o fechamento de conversa.
# CHATWOOT_CLIENTE_FREQUENTE_MIN e CHATWOOT_CLIENTE_FREQUENTE_MESES: o cliente e frequente com MIN ou mais pedidos
# concretizados (aprovado, em producao, pronto para entrega ou entregue) criados nos ultimos MESES meses.
# CHATWOOT_FECHAMENTO_ATRASO_MIN_S e CHATWOOT_FECHAMENTO_ATRASO_MAX_S: a mensagem de encerramento sai depois de um atraso
# sorteado entre MIN e MAX segundos (teto de 900). Reiniciar o backend descarta mensagens de encerramento ainda agendadas;
# as etiquetas ja foram aplicadas na hora.
# O fechamento depende das variaveis CHATWOOT_AUTOMATION_* e CHATWOOT_AI_* do PR #75, que precisa estar implantado antes.
# Em producao, CHATWOOT_AUTOMATION_STATUS_FECHAMENTO deve ser PRONTO_PARA_ENTREGA,ENTREGUE,ENVIADO,CANCELADO.
CHATWOOT_ETIQUETAS_ATIVAS=true
CHATWOOT_CLIENTE_FREQUENTE_MIN=3
CHATWOOT_CLIENTE_FREQUENTE_MESES=6
CHATWOOT_FECHAMENTO_ATRASO_MIN_S=45
CHATWOOT_FECHAMENTO_ATRASO_MAX_S=180

# Pesquisa de satisfacao e recompensa (Fase 52). O liga/desliga fica na tela
# /configuracoes/pesquisa e a pesquisa nasce DESLIGADA. Os padroes abaixo so valem na
# criacao da linha de configuracao (primeira leitura); depois a tela manda.
# Valores de exemplo do Bom Custo. O Box usa PESQUISA_TETO_PADRAO=2,
# PESQUISA_COMPRA_MINIMA_PADRAO=6 e PESQUISA_PREFIXO_PADRAO=BOX.
# PESQUISA_CSAT_NATIVO_ATIVO: somente o texto "false" desliga a criacao da input_csat privada
# no Chatwoot (fallback se a mensagem privada nao funcionar na homologacao).
# PESQUISA_RETENCAO_ATIVA: somente o texto "true" liga a anonimizacao de 12 meses; depende do
# parecer juridico. PESQUISA_RETENCAO_MESES aceita inteiro >= 1 (outro valor volta a 12).
# CHATWOOT_WEBHOOK_SECRET: segredo do webhook de conta message_created (SAIR) criado no Chatwoot;
# e o mesmo valor mostrado no cadastro do webhook. Nunca commitar o valor real.
# As etiquetas avaliou e csat-baixo sao criadas a mao em 52-ROTEIRO-HOMOLOGACAO.md, em cada conta,
# com um token de administrador digitado na hora: nao existe env para esse token.
# O CSAT nativo das inboxes WhatsApp precisa estar DESLIGADO no Chatwoot (hoje esta LIGADO na
# inbox 1 do Box, e ligado o cliente receberia dois links); o sistema registra aviso no log se
# encontrar a inbox com o CSAT nativo ligado.
# O fechamento depende das envs CHATWOOT_AUTOMATION_* do PR #75, ja presentes nesta base.
PESQUISA_PERCENTUAL_PADRAO=10
PESQUISA_TETO_PADRAO=5
PESQUISA_COMPRA_MINIMA_PADRAO=30
PESQUISA_TETO_MENSAL_PADRAO=300
PESQUISA_PREFIXO_PADRAO=BC
PESQUISA_CSAT_NATIVO_ATIVO=true
PESQUISA_RETENCAO_ATIVA=false
PESQUISA_RETENCAO_MESES=12
CHATWOOT_WEBHOOK_SECRET=

# SMB/Samba — credenciais e host para montar o share de anexos do Athos em Docker
# O share //<SMB_HOST>/html/Anexo/contapagar é montado em /mnt/samba/contapagar
SMB_HOST=192.168.3.203
SMB_USER=
SMB_PASS=
SMB_DOMAIN=WORKGROUP
ATHOS_SMB_HOST_MOUNT_PATH=/mnt/samba/contapagar
ATHOS_SMB_MOUNT_PATH=/mnt/samba/contapagar

PDV_DB_URL=
PDV_DB_SCHEMA=public
PDV_DB_READONLY_USER=
PDV_DB_READONLY_PASSWORD=

# MinIO
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=orcamento
MINIO_REGION=us-east-1
MINIO_PUBLIC_BASE_URL=
MINIO_PATH_PREFIX=quotes

# EFI Bank
BACKEND_URL=https://seu-dominio.com/api
EFI_BASE_URL=https://pix.api.efipay.com.br
EFI_COBRANCA_BASE_URL=https://cobrancas.api.efipay.com.br
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
EFI_CERT_PEM=
EFI_KEY_PEM=
INTERNAL_API_KEY=
EFI_WEBHOOK_SECRET=

# E-mail (SMTP - nodemailer). Gmail exige App Password: ativar verificacao em 2 etapas na
# conta Google e criar uma "Senha de app" em https://myaccount.google.com/apppasswords.
# SMTP_USER deve ser IDENTICO ao endereco entre <...> do SMTP_FROM (Gmail nao deixa
# "enviar em nome de" outro endereco). NAO commitar credenciais reais.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Financeiro Bom Custo Papelaria & Gráfica <financeiro@bomcustoilhabela.com.br>"

# NFS-e (iiBrasil - Prefeitura de Ilhabela) — descontinuado, anexo manual do XML
NFSE_TOKEN=

# NFS-e Nacional (ADN/Sefin Nacional) — emissao automatica via API do governo.
# Certificado A1 (e-CNPJ) em PEM: extrair do .pfx com openssl e colar o conteudo
# completo (com as quebras de linha) direto nestas variaveis — nao subir o .pfx.
NFSE_NACIONAL_CERT_PEM=
NFSE_NACIONAL_KEY_PEM=
NFSE_NACIONAL_CNPJ_PRESTADOR=62391927000157
NFSE_NACIONAL_CODIGO_MUNICIPIO=3520400
# producao | homologacao
NFSE_NACIONAL_AMBIENTE=producao

# Contato de empresa (opcionais; sem elas a linha some no PDF e no header do site)
# EMPRESA_TELEFONES: telefones de contato (string livre). Alimenta o rodape do PDF E o
#   header das paginas web. ex: (12) 99648-4918 · (12) 3896-1474
# EMPRESA_WHATSAPP: numero (somente digitos, com DDI) usado nos links "Fale conosco" (wa.me)
#   das paginas de status/aprovacao do cliente. Sem ele, o bloco de contato some. ex: 5512996484918
# EMPRESA_EMAIL: email de contato  ex: orcamento@suaempresa.com.br
# EMPRESA_INSTAGRAM: handle do Instagram (somente PDF)  ex: @suaempresa
EMPRESA_TELEFONES=
EMPRESA_WHATSAPP=
EMPRESA_EMAIL=
EMPRESA_INSTAGRAM=

# Frontend
BACKEND_URL=http://ts-webserver2:4000/api

# Painel Admin de Templates PDF (server-side; consumido por backend e frontend)
# ADMIN_API_KEY: mesma chave nos dois containers. Gerar: openssl rand -hex 32
# CONFIG_PANEL_PASSWORD: senha do painel /configuracoes/templates (fail-open se vazia!)
# CONFIG_PANEL_SESSION_SECRET: segredo do cookie de sessao (fallback p/ ADMIN_API_KEY se vazio)
ADMIN_API_KEY=
CONFIG_PANEL_PASSWORD=
CONFIG_PANEL_SESSION_SECRET=
