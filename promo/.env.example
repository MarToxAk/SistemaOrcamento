# Porta em que o servidor promo escuta (padrao 3100 se ausente)
PORT=3100

# Caminho do arquivo SQLite dedicado do sorteio (padrao ./data/promo.db se ausente)
PROMO_DB_PATH=./data/promo.db

# Segredo exigido para baixar o CSV de cadastros (GET /api/cadastros.csv).
# Gere com: openssl rand -hex 24
# Sem esta variavel definida no servidor, a rota responde 503 (fail-closed).
PROMO_ADMIN_TOKEN=

# Ligar quando o servidor roda atras de um proxy reverso confiavel (nginx em
# producao) para o rate limit considerar o primeiro salto de x-forwarded-for.
# Exposto direto na internet (sem proxy), NUNCA ligar — o header seria forjavel.
TRUST_PROXY=

# --- Validacao do cupom fiscal (COO) no Athos, via backend NestJS ---------
# Sem as 3 variaveis abaixo, o cadastro responde 503 (fail-closed) e ninguem
# consegue se cadastrar — nao e opcional para o sorteio funcionar.

# URL base do backend NestJS de orcamento, JA INCLUINDO o prefixo /api (o
# backend roda com setGlobalPrefix('api')). Candidato em producao:
# http://host.docker.internal:4001/api (alias de host publicado pelo compose
# do promo); alternativa: a URL publica https do backend. Validar com um
# curl antes do sorteio (ver README).
PROMO_ATHOS_BASE_URL=

# MESMO valor de ATHOS_API_TOKEN configurado no backend (deploy/stack.env) —
# o endpoint compara com timingSafeEqual. NUNCA gravar aqui um valor real,
# so em deploy/promo.env (nao versionado).
PROMO_ATHOS_API_TOKEN=

# MESMO valor de INTERNAL_API_KEY do backend — o InternalAuthGuard global
# exige esse header em toda rota nao-@Public. NUNCA gravar aqui um valor
# real, so em deploy/promo.env (nao versionado).
PROMO_BACKEND_INTERNAL_API_KEY=

# Timeout (ms) da chamada ao backend de validacao. Default 5000 se ausente.
PROMO_ATHOS_TIMEOUT_MS=

# --- Envio de WhatsApp de confirmacao via Evolution API (best-effort) -----
# Sem as 3 variaveis abaixo, o cadastro continua funcionando normalmente —
# so nao envia a mensagem de confirmacao (D-04).

# Raiz do host da instancia Evolution API (sem /manager e sem barra final).
PROMO_WHATSAPP_HOST=

# NOME da instancia Evolution (nao o UUID). Atencao: o identificador que
# aparece na URL do painel /manager/instance/<uuid>/dashboard e o UUID, mas
# a API espera o NOME. Descobrir com:
# GET {PROMO_WHATSAPP_HOST}/instance/fetchInstances (header apikey)
PROMO_WHATSAPP_INSTANCE=

# apikey da instancia Evolution. NUNCA gravar aqui um valor real, so em
# deploy/promo.env (nao versionado).
PROMO_WHATSAPP_API_KEY=

# Timeout (ms) do envio de WhatsApp. Default 5000 se ausente.
PROMO_WHATSAPP_TIMEOUT_MS=
