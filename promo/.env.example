# Porta em que o servidor promo escuta (padrao 3100 se ausente)
PORT=3100

# Caminho do arquivo SQLite dedicado do sorteio (padrao ./data/promo.db se ausente)
PROMO_DB_PATH=./data/promo.db

# Segredo exigido para baixar o CSV de cadastros (GET /api/cadastros.csv).
# Gere com: openssl rand -hex 24
# Sem esta variavel definida no servidor, a rota responde 503 (fail-closed).
PROMO_ADMIN_TOKEN=

# Ligar quando o servidor roda atras de um proxy reverso confiavel (nginx em
# producao) para o rate limit considerar o primeiro salto de x-forwarded-for.
# Exposto direto na internet (sem proxy), NUNCA ligar — o header seria forjavel.
TRUST_PROXY=
