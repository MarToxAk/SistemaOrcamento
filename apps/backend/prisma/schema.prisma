generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataSource {
  MANUAL
  PDV
  CHATWOOT
}

enum PriceSource {
  MANUAL
  PDV
}

enum QuoteStatus {
  PENDENTE
  PAGAMENTO_PARCIAL
  APROVADO
  EM_PRODUCAO
  PRONTO_PARA_ENTREGA
  ENTREGUE
  ENVIADO
  CANCELADO
}

enum UserRole {
  VENDEDOR
  ATENDENTE
  ADMIN
}

enum ExternalSystem {
  PDV
  CHATWOOT
}

model Customer {
  id                String   @id @default(uuid())
  fullName          String
  phone             String?
  email             String?
  source            DataSource @default(MANUAL)
  chatwootContactId BigInt?   @db.BigInt
  isAssociated Boolean @default(false)
  quotes            Quote[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model User {
  id            String               @id @default(uuid())
  name          String
  email         String?              @unique
  role          UserRole             @default(VENDEDOR)
  isActive      Boolean              @default(true)
  createdQuotes Quote[]              @relation("QuoteCreatedBy")
  statusChanges QuoteStatusHistory[] @relation("StatusChangedBy")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Quote {
  id                 String               @id @default(uuid())
  internalNumber     Int                  @unique @default(autoincrement())
  externalQuoteId    BigInt?              @db.BigInt @unique
  customerId         String
  createdById        String?
  status             QuoteStatus           @default(PENDENTE)
  source             DataSource            @default(MANUAL)
  sellerExternalId   BigInt?               @db.BigInt
  saleExternalId     BigInt?               @db.BigInt
  sellerName         String?
  conversationId     BigInt?               @db.BigInt
  chatwootContactId  BigInt?               @db.BigInt
  paymentSource      String?
  paymentMethod      String?
  paymentExternalId  String?               @unique
  paymentEventId     String?               @unique
  paymentAmount      Decimal?              @db.Decimal(12, 2)
  paymentDiscount    Decimal               @default(0) @db.Decimal(12, 2)
  paidTotal          Decimal               @default(0) @db.Decimal(12, 2)
  pendingTotal       Decimal               @default(0) @db.Decimal(12, 2)
  firstInstallmentAmount Decimal?          @db.Decimal(12, 2)
  secondInstallmentAmount Decimal?         @db.Decimal(12, 2)
  secondInstallmentExternalId String?      @unique
  cardChargeId       String?               @unique
  paymentConfirmedAt DateTime?
  paymentFailedAt    DateTime?
  paymentFailureReason String?
  paymentNote        String?
  validity           String?
  deliveryDate       DateTime?
  paymentTerms       String?
  notes              String?
  budgetDate         DateTime?
  editedAt           DateTime?
  subtotal           Decimal               @default(0) @db.Decimal(12, 2)
  discount           Decimal               @default(0) @db.Decimal(12, 2)
  surcharge          Decimal               @default(0) @db.Decimal(12, 2)
  total              Decimal               @default(0) @db.Decimal(12, 2)
  customer           Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy          User?                 @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  items              QuoteItem[]
  stamps             QuoteStampItem[]
  statusHistory      QuoteStatusHistory[]
  documents          QuoteDocument[]
  paymentTransactions PaymentTransaction[]
  approvalToken       String?
  approvalRequestedAt DateTime?
  approvalExpiresAt   DateTime?
  approved            Boolean               @default(false)
  approvedAt          DateTime?
  nfseNumero          String?
  nfseCodigoVerificacao String?
  nfseLink            String?
  nfseEmitidaEm       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, updatedAt])
  
  @@index([conversationId])
  @@index([chatwootContactId])
  @@index([saleExternalId])
  @@index([paymentSource, paymentMethod])
  @@index([paymentConfirmedAt])
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  quoteId       String
  externalId    String?  @unique
  eventId       String?  @unique
  source        String
  method        String
  status        String
  amount        Decimal  @db.Decimal(12, 2)
  metadata      Json?
  webhookPayload Json?
  processedAt   DateTime @default(now())
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, processedAt])
  @@index([source, method, status])
}

model QuoteItem {
  id                String      @id @default(uuid())
  quoteId           String
  parentItemId      String?
  sequence          Int
  externalItemId    BigInt?     @db.BigInt
  productExternalId BigInt?     @db.BigInt
  reference         String?
  shortDescription  String
  description       String
  quantity          Decimal     @db.Decimal(10, 2)
  unitPrice         Decimal     @db.Decimal(12, 2)
  discount          Decimal     @default(0) @db.Decimal(12, 2)
  finalPrice        Decimal     @db.Decimal(12, 2)
  priceSource       PriceSource @default(MANUAL)
  quote             Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  parentItem        QuoteItem?  @relation("QuoteItemChildren", fields: [parentItemId], references: [id], onDelete: SetNull)
  children          QuoteItem[] @relation("QuoteItemChildren")
  createdAt         DateTime    @default(now())

  @@index([quoteId, sequence])
  @@index([parentItemId])
}

model QuoteStampItem {
  id          String   @id @default(uuid())
  quoteId     String
  number      Int
  stampType   String
  dimensions  String?
  description String?
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([quoteId, number])
}

model QuoteStatusHistory {
  id            String      @id @default(uuid())
  quoteId       String
  oldStatus     QuoteStatus?
  newStatus     QuoteStatus
  changedById   String?
  changedByName String
  changedAt     DateTime    @default(now())
  quote         Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  changedBy     User?       @relation("StatusChangedBy", fields: [changedById], references: [id])
}

model QuoteDocument {
  id           String   @id @default(uuid())
  quoteId      String
  fileName     String
  contentType  String
  storagePath  String
  publicUrl    String?  @db.Text
  generatedBy  String
  generatedAt  DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, generatedAt])
}

model ExternalReference {
  id             String         @id @default(uuid())
  entityType     String
  entityId       String
  externalSystem ExternalSystem
  externalId     String
  createdAt      DateTime       @default(now())

  @@index([externalSystem, externalId])
  @@unique([externalSystem, externalId, entityType])
}

model CobrancaBoleto {
  id             Int                    @id @default(autoincrement())
  txidEfi        String?
  idclienteAthos Int
  valor          Decimal                @db.Decimal(12, 2)
  status         String                 @default("pendente")
  linkBoleto     String?
  pixPayload     String?
  nomeArquivo    String?
  expireAt       String?
  criadoEm       DateTime               @default(now())
  atualizadoEm   DateTime               @updatedAt
  titulos        CobrancaBoletoTitulo[]
  emailEnvios    CobrancaEmailEnvio[]
  avisos         CobrancaAvisoVencimento[]

  // Fase 43 (BX-07): resultado duravel da baixa no Athos
  athosBaixaStatus        String?   // null = nunca processado (inclui tudo que ficou pago antes da Fase 43); pendente | baixado | ja_baixado | falha | estornado
  athosBaixaErroCodigo    String?
  athosBaixaErroMensagem  String?   // ate 300 caracteres, sem dados de cliente
  athosBaixaTentativas    Int       @default(0)
  athosBaixaUltimaEm      DateTime?
  athosBaixaDataPagamento String?   // YYYY-MM-DD resolvida na 1a tentativa (America/Sao_Paulo)
  athosBaixaValorPagoEfi  Decimal?  @db.Decimal(12, 2)

  // Fase 50 (D-08, D-11, D-12, D-14): boleto atualizado com juros e multa
  boletoOrigemId               Int?
  boletoOrigem                 CobrancaBoleto?  @relation("BoletoAtualizacao", fields: [boletoOrigemId], references: [id], onDelete: SetNull)
  boletosAtualizados           CobrancaBoleto[] @relation("BoletoAtualizacao")
  valorPrincipal               Decimal?         @db.Decimal(12, 2)
  valorJuros                   Decimal?         @db.Decimal(12, 2)
  valorMulta                   Decimal?         @db.Decimal(12, 2)
  taxaJurosMesAplicada         Decimal?         @db.Decimal(7, 4)
  multaPercentualAplicada      Decimal?         @db.Decimal(7, 4)
  taxaJurosMesPosVencimento    Decimal?         @db.Decimal(7, 4)
  multaPercentualPosVencimento Decimal?         @db.Decimal(7, 4)
  mensagemAtualizacao          String?

  @@index([athosBaixaStatus])
  @@index([boletoOrigemId])
}

/// Trilha append-only das tentativas de baixa e estorno no Athos - Fase 43. Sem FK: preserva a auditoria se o boleto local for removido.
model CobrancaBaixaAthosLog {
  id               Int      @id @default(autoincrement())
  cobrancaBoletoId Int
  operacao         String   // baixa | estorno
  origem           String   // webhook | reconciliacao | manual | retentativa
  resultado        String   // baixado | ja_baixado | pendente | falha | estornado
  codigoErro       String?
  mensagem         String?
  dataPagamento    String?
  valorTotal       Decimal? @db.Decimal(12, 2)
  titulos          Json?    // [{ idcontareceber, idcontarecebida, principal, juros, multa, atraso, valorPago }]
  criadoEm         DateTime @default(now())

  @@index([cobrancaBoletoId])
}

model CobrancaEmailEnvio {
  id               Int             @id @default(autoincrement())
  token            String          @unique
  idclienteAthos   Int
  destinatario     String
  cc               String[]        @default([]) // destinatarios em copia (CC) ja normalizados — Fase 42 (D-05)
  assunto          String?
  status           String          @default("enviado") // enviado | aberto | confirmado
  cobrancaBoletoId Int?
  nfseEmitidaIds   Int[]
  nfeNumeros       String[]        // Athos nota.numero (texto curto) das NF-e anexadas como XML
  enviadoEm        DateTime        @default(now())
  abertoEm         DateTime?
  confirmadoEm     DateTime?
  criadoEm         DateTime        @default(now())
  atualizadoEm     DateTime        @updatedAt
  cobrancaBoleto   CobrancaBoleto? @relation(fields: [cobrancaBoletoId], references: [id], onDelete: SetNull)

  @@index([idclienteAthos])
  @@index([cobrancaBoletoId])
}

/// Lista fixa de e-mails em copia (CC) por cliente do Athos — Fase 42 (D-06). Pre-preenche o modal de envio.
model CobrancaEmailCcPadrao {
  idclienteAthos Int      @id
  emails         String[] @default([])
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
}

/// Registro idempotente dos avisos de vencimento/atraso por boleto - Fase 45 (D-05). Banco do Sistema apenas.
model CobrancaAvisoVencimento {
  id               Int            @id @default(autoincrement())
  cobrancaBoletoId Int
  idclienteAthos   Int
  tipo             String         // D-3 | D-1 | A+2 | A+7 | A+14
  status           String         @default("enviando") // enviando | enviado | erro | sem_email
  destinatario     String?
  cc               String[]       @default([])
  erro             String?        // ate 300 caracteres, sem e-mail nem dados do cliente
  tentativas       Int            @default(0)
  enviadoEm        DateTime?
  criadoEm         DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt
  cobrancaBoleto   CobrancaBoleto @relation(fields: [cobrancaBoletoId], references: [id], onDelete: Cascade)

  @@unique([cobrancaBoletoId, tipo])
  @@index([idclienteAthos])
}

model CobrancaBoletoTitulo {
  id               Int            @id @default(autoincrement())
  cobrancaBoletoId Int
  idcontareceber   Int
  valor            Decimal        @db.Decimal(12, 2)
  cobrancaBoleto   CobrancaBoleto @relation(fields: [cobrancaBoletoId], references: [id])

  // Fase 50 (D-11, D-13): snapshot dos encargos por titulo (valor continua sendo o PRINCIPAL)
  juros              Decimal? @db.Decimal(12, 2)
  multa              Decimal? @db.Decimal(12, 2)
  diasAtraso         Int?
  vencimentoOriginal String?

  @@index([cobrancaBoletoId])
  @@index([idcontareceber])
}

model NfseEmitida {
  id             Int                 @id @default(autoincrement())
  numeroNfse     String?
  numeroRps      Int?                // legado (emissao SOAP descontinuada); anexo manual nao tem RPS
  idclienteAthos Int
  valorServico   Decimal             @db.Decimal(12, 2)
  linkNfse       String?             // URL publica do XML anexado manualmente
  chaveAcesso    String?             // Id do infNFSe (padrao nacional NBS)
  xmlNacional    String?             @db.Text   // cache do XML assinado (padrao nacional) p/ render do DANFSe via nfse-node
  arquivoPath    String?             // objectName no MinIO
  arquivoNome    String?             // nome original do arquivo enviado
  dataEmissao    DateTime            @default(now())
  criadoEm       DateTime            @default(now())
  idvenda        Int?                // D-07: venda Athos que originou a NFS-e
  titulos        NfseEmitidaTitulo[]

  @@index([idvenda])                 // D-23: busca eficiente de duplicidade por venda
}

model NfseEmitidaTitulo {
  id             Int         @id @default(autoincrement())
  nfseEmitidaId  Int
  idcontareceber Int
  valor          Decimal     @db.Decimal(12, 2)
  nfseEmitida    NfseEmitida @relation(fields: [nfseEmitidaId], references: [id])

  @@index([nfseEmitidaId])
  @@index([idcontareceber])
}

// Cursor singleton (id fixo = 1) da Distribuicao de DF-e do ADN. ultimoNsu = maior NSU
// ja processado pelo backfill (NfseNacionalDistribuicaoService.sincronizar). Idempotente.
model NfseDfeSync {
  id           Int      @id @default(1)
  ultimoNsu    Int      @default(0)
  atualizadoEm DateTime @updatedAt
}

enum PdfTemplateKind {
  PRESET
  CUSTOM
}

// PdfTemplate: armazena templates Handlebars/HTML para geração de PDF de orçamento.
// Unicidade do ativo (no máximo um isActive=true por deploy) é garantida por transação
// no serviço (Plano 05), não por constraint de banco — Postgres não tem partial unique
// trivial via Prisma para campo boolean.
model PdfTemplate {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  source    String          @db.Text
  kind      PdfTemplateKind
  isActive  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive])
}

// OrcamentoItemCorrecao: correcao manual de item de orcamento vindo do Athos (PDV).
// O Athos e a fonte de dados do orcamento e nao pode ser alterado diretamente (dado
// de producao do PDV). Quando um item chega com valor errado por erro de digitacao no
// caixa (ex: orcamento #21659 — valorvenda1=3.30 no catalogo, mas lancado como 2.50),
// registramos aqui o valor correto e o backend aplica a correcao ao ler o orcamento do
// Athos, sem tocar no banco do PDV.
model OrcamentoItemCorrecao {
  id              String   @id @default(uuid())
  idOrcamento     String
  idItemOrcamento String
  valorItem       Decimal  @db.Decimal(12, 2)
  valorDesconto   Decimal  @default(0) @db.Decimal(12, 2)
  valorFinalItem  Decimal  @db.Decimal(12, 2)
  motivo          String?
  criadoPor       String?
  createdAt       DateTime @default(now())

  @@unique([idOrcamento, idItemOrcamento])
  @@index([idOrcamento])
}

// ChatwootAutomationConfig: textos editaveis da automacao de fechamento de conversa
// do Chatwoot (substitui o fluxo que rodava no n8n). Linha singleton (id fixo "default")
// para nao precisar de tela de listagem — so existe uma configuracao ativa.
model ChatwootAutomationConfig {
  id                     String   @id @default("default")
  promptFechamento       String   @db.Text
  mensagemPedidoPendente String   @db.Text
  updatedAt              DateTime @updatedAt
  updatedBy              String?
}

/// Fase 50 (D-07): taxas padrao do boleto atualizado (singleton id "default").
model CobrancaEncargosConfig {
  id              String   @id @default("default")
  taxaJurosMes    Decimal  @default(0.99) @db.Decimal(7, 4)
  multaPercentual Decimal  @default(2) @db.Decimal(7, 4)
  atualizadoEm    DateTime @updatedAt
}

// Registro de mensagens de automacao enviadas por conversa (ex.: evita reenviar a
// mensagem de fechamento no mesmo dia). Substitui a tabela "mensagens_enviadas" do
// banco externo de pedidos, que deixou de ser usado pela automacao do Chatwoot.
model ChatwootMensagemEnviada {
  id               String   @id @default(uuid())
  conversationId   String
  tipoEvento       String
  mensagemEnviada  String   @db.Text
  enviadoEm        DateTime @default(now())

  @@index([conversationId, tipoEvento, enviadoEm])
}

/// Idempotencia e auditoria dos orcamentos criados pela IA no Athos - Fase 44. Sem FK: o Athos e externo.
model AthosOrcamentoIa {
  id             Int      @id @default(autoincrement())
  idempotencyKey String?  @unique // NULL quando o chamador nao envia o header Idempotency-Key
  payloadHash    String // sha256 do corpo canonico sem "simular"
  status         String   @default("processando") // processando | criado
  idorcamento    Int?
  senhabalcao    Int?
  valorBruto     Decimal? @db.Decimal(12, 2)
  valorLiquido   Decimal? @db.Decimal(12, 2)
  request        Json?
  resposta       Json?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@index([idorcamento])
}

/// Fase 52 (D-03): CSAT com recompensa e convite do Google. Cupom de desconto emitido quando o cliente responde a pesquisa.
enum CupomStatus {
  EMITIDO
  USADO
  EXPIRADO
  CANCELADO
}

/// Fase 52 (D-42): configuracao da pesquisa (singleton id "default"). ativo false e o kill-switch.
model PesquisaConfig {
  id                          String   @id @default("default")
  ativo                       Boolean  @default(false)
  percentualDesconto          Decimal  @default(10) @db.Decimal(5, 2)
  tetoDesconto                Decimal  @default(5) @db.Decimal(12, 2)
  compraMinima                Decimal  @default(30) @db.Decimal(12, 2)
  validadeCupomDias           Int      @default(30)
  validadeLinkDias            Int      @default(7)
  intervaloDias               Int      @default(90)
  tetoMensal                  Decimal  @default(300) @db.Decimal(12, 2)
  prefixoCupom                String   @default("BC")
  linkGoogle                  String?
  varianteVisual              String   @default("AB") // ESTRELAS | CARINHAS | AB
  textoFechamento             String   @db.Text
  textoSemRecompensa          String   @db.Text
  textoPosResposta            String   @db.Text
  textoConviteGoogle          String   @db.Text
  paginaTitulo                String
  paginaSubtitulo             String
  paginaObrigadoSemRecompensa String
  paginaGoogleTitulo          String
  paginaGoogleCorpo           String
  atualizadoEm                DateTime @updatedAt
  atualizadoPor               String?
}

/// Fase 52: uma pesquisa por link enviado. telefone e conversationId ficam NULOS so depois da anonimizacao (plano 52-06).
model PesquisaSatisfacao {
  id                      String           @id @default(uuid())
  token                   String           @unique
  conversationId          BigInt?          @db.BigInt
  conversationUuid        String?
  contactId               BigInt?          @db.BigInt
  telefone                String? // normalizado (55 + DDD + numero)
  customerId              String?
  variante                String // ESTRELAS | CARINHAS
  status                  String           @default("CRIADA") // CRIADA | ENVIADA | RESPONDIDA
  chatwootCsat            String           @default("AGUARDANDO_MENSAGEM") // AGUARDANDO_MENSAGEM | MENSAGEM_OK | MENSAGEM_FALHA | RESPOSTA_FALHA | OK | NAO_APLICAVEL
  nota                    Int?
  comentario              String?          @db.VarChar(500)
  envioConviteStatus      String           @default("PENDENTE") // PENDENTE | ENVIANDO | ENVIADA | FALHA | NAO_APLICAVEL
  envioConviteReservadoEm DateTime? // reserva antes de enviar (plano 52-05)
  tentativasEnvio         Int              @default(0)
  criadaEm                DateTime         @default(now())
  enviadaEm               DateTime?
  expiraEm                DateTime
  respondidaEm            DateTime?
  anonimizadaEm           DateTime?
  revogadaEm              DateTime? // plano 52-12 (revogacao); nulo = link valido
  cupom                   CupomRecompensa?

  @@index([conversationId])
  @@index([telefone, criadaEm])
  @@index([respondidaEm])
}

/// Fase 52: cupom unico por pesquisa respondida.
model CupomRecompensa {
  id                    String             @id @default(uuid())
  codigo                String             @unique
  pesquisaId            String             @unique
  pesquisa              PesquisaSatisfacao @relation(fields: [pesquisaId], references: [id])
  telefone              String? // nulo so depois da anonimizacao (plano 52-06)
  percentual            Decimal            @db.Decimal(5, 2)
  teto                  Decimal            @db.Decimal(12, 2)
  compraMinima          Decimal            @db.Decimal(12, 2)
  status                CupomStatus        @default(EMITIDO)
  validadeAte           DateTime
  envioCupomStatus      String             @default("PENDENTE") // PENDENTE | ENVIANDO | ENVIADA | FALHA | NAO_APLICAVEL
  envioCupomReservadoEm DateTime? // reserva antes de enviar (plano 52-05)
  valorCompra           Decimal?           @db.Decimal(12, 2)
  descontoAplicado      Decimal?           @db.Decimal(12, 2)
  usadoEm               DateTime?
  usadoPor              String?
  criadoEm              DateTime           @default(now())

  @@index([telefone, criadoEm])
  @@index([status, usadoEm])
}

/// Fase 52 (D-49): telefones que pediram SAIR; nunca recebem pesquisa.
model PesquisaSupressao {
  telefone String   @id
  origem   String   @default("SAIR")
  criadoEm DateTime @default(now())
}

/// Fase 54 (D-09): auditoria de cada tentativa de liberacao da NFS-e por senha.
/// SEM relacao com Quote de proposito: a fusao de orcamentos (quotes.service) apaga
/// linhas de Quote e a trilha precisa sobreviver. Nunca guarda a senha nem hash dela.
model NfseLiberacao {
  id          String   @id @default(uuid())
  quoteId     String
  quoteNumero String?
  resultado   String // LIBERADO | SENHA_INVALIDA | NAO_CONFIGURADA | BLOQUEADO
  situacao    String // PARCIAL | SEM_PAGAMENTO (situacao do pagamento no momento)
  valorPago   Decimal  @db.Decimal(12, 2)
  valorDevido Decimal  @db.Decimal(12, 2)
  valorNota   Decimal? @db.Decimal(12, 2)
  liberadoPor String?
  ip          String?
  userAgent   String?
  nfseNumero  String?
  criadoEm    DateTime @default(now())

  @@index([quoteId, criadoEm])
  @@index([criadoEm])
}
